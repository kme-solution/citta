# Local PostgreSQL connection. Replace CHANGE_ME before database commands.
# URL-encode special characters in credentials. No AI API key is required.
DATABASE_URL='postgresql://citta:CHANGE_ME@127.0.0.1:5432/citta'
CITTA_CODEX_PATH=''

# My configured identity. Leave unknown attributes blank.
# Age: whole years (0-150). Restart the portal after editing.
# This background is shared with Codex only when I consult it.
CITTA_NAME=''
CITTA_AGE=''
CITTA_GENDER=''
CITTA_BACKGROUND=''
CITTA_OCCUPATION=''
CITTA_LOCATION=''
CITTA_LANGUAGE=''
CITTA_VALUES=''
CITTA_GOALS=''

# Continuing runtime. .env.runtime can privately override the database selection.
# Use npm run db:prepare to select a separate local database without changing DATABASE_URL.
CITTA_AGENT_ID='local'
CITTA_PORT=4173
CITTA_TEMPORAL_ADDRESS='127.0.0.1:7233'
CITTA_TEMPORAL_NAMESPACE='default'
CITTA_OLLAMA_URL='http://127.0.0.1:11434'
# Candidate only: English/Myanmar quality and latency still need evaluation.
CITTA_LOCAL_MODEL='qwen3:4b-instruct-2507-q4_K_M'
CITTA_MODEL_THREADS=3
CITTA_INFERENCE_TIMEOUT_MS=300000
# 1000: continue from an enabled interest on the next idle cycle.
CITTA_INTERNAL_INTERVAL_MS=1000
CITTA_CONTACT_INTERVAL_MS=3600000
# 0 allows continuous consideration without an app hourly cutoff; provider/goal limits remain.
CITTA_HOURLY_WORK_LIMIT=12
# Add your own permitted evidence files here; demos/tests select fixtures explicitly.
CITTA_READ_ROOT='.local/sources'
CITTA_ADVISER_ENABLED=true
# Codex dispatch waits for portal sign-in. Evaluate an offline model before enabling Ollama.
CITTA_COGNITION_ENABLED=true
# Optional modeled-affect ablation; does not disable evidence, interpretation or authorization.
CITTA_AFFECT_ENABLED=true

# Explicit cognition provider: ollama (offline) or codex (external context sharing).
CITTA_COGNITION_PROVIDER='codex'
# Optional Codex model override; blank uses your CLI configuration.
CITTA_CODEX_MODEL=''

# Real laptop desktop control through GNOME Wayland permission portals.
# An OS-approved screen/input session is required; no automatic session at startup.
CITTA_COMPUTER_ENABLED=false
CITTA_COMPUTER_AUTONOMOUS=false
CITTA_COMPUTER_PORT=4180

# Persistent Codex connection with portal sign-in; exec retains legacy per-call CLI behavior.
CITTA_CODEX_TRANSPORT='app-server'
# Sign in or enter a key in portal Connections; do not put credentials in identity fields.

# Interrupt a Codex turn with no progress for this long; then briefly cool down.
CITTA_CODEX_PROGRESS_TIMEOUT_MS=60000
